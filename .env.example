# Arc Network
RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=stash
DATABASE_USER=stash
DATABASE_PASSWORD=stash

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d

# Stash Contracts (set after deployment)
STASH_VAULT_ADDRESS=
STASH_CREDIT_ADDRESS=
STASH_ROUTER_ADDRESS=
STASH_LIQUIDATION_ADDRESS=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.arc.io
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Confirmation and oracle safety
TX_CONFIRMATIONS=2
ORACLE_MAX_AGE_SECONDS=300
# Production disables schema synchronization; build and run migration:run first.

# Administrator operators authenticate with wallets; financial changes still require the Safe/timelock.
ADMIN_WALLETS=
STASH_TIMELOCK_ADDRESS=
# Use TLS for hosted PostgreSQL and rediss:// for hosted Redis.
DATABASE_SSL=false
REDIS_URL=
