RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=stash
DATABASE_USER=stash
DATABASE_PASSWORD=changeme
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=changeme-use-a-strong-random-secret
JWT_EXPIRY=7d
CORS_ORIGIN=http://localhost:3000
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
PORT=3001
STASH_VAULT_ADDRESS=
STASH_CREDIT_ADDRESS=
STASH_ROUTER_ADDRESS=
STASH_LIQUIDATION_ADDRESS=

# Confirmation and oracle safety
TX_CONFIRMATIONS=2
ORACLE_MAX_AGE_SECONDS=300
# Production disables schema synchronization; build and run migration:run first.

# Deploy and verify the Arc V4 contracts before supplying these values.
INDEXER_START_BLOCK=
WORKERS_ENABLED=true
ROUTING_PROVIDERS=0x,lifi
ZEROX_API_KEY=
LIFI_API_KEY=
# Keep disabled until a dedicated signer, allowances, liquidity and monitoring are verified.
KEEPER_ENABLED=false
KEEPER_ADDRESS=
KEEPER_SIGNER_URL=
KEEPER_SIGNER_TOKEN=

# Administrator operators authenticate with wallets; financial changes still require the Safe/timelock.
ADMIN_WALLETS=
STASH_TIMELOCK_ADDRESS=
# Use TLS for hosted PostgreSQL and rediss:// for hosted Redis.
DATABASE_SSL=false
REDIS_URL=

# Require a recent independent worker heartbeat for production readiness.
WORKERS_REQUIRED=true
KEEPER_MAX_USDC_ATOMIC=
KEEPER_MIN_PROFIT_USD6=
