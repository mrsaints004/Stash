# STASH Protocol — Arc Mainnet Configuration
# Copy to .env.mainnet and fill in your values.

# Deployer
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Aave V4
AAVE_V4_SPOKE=0xB843bdC3a87A05E77E07Df9FE48928b3A34b134d

# Assets
USDC_ADDRESS=0x3600000000000000000000000000000000000000
WETH_ADDRESS=0x128cC466B61f542da60c70e3aA11c10e19B84EDB
BTC_ADDRESS=0x171A4217b86A807A64eB94757Db6849fb4bDbAA0

# Price feeds
WETH_USD_FEED=0x2c7Dc3567b3490f53A8d32625d766834dd023F60
BTC_USD_FEED=0x7777547914e03BCbB04Ae034942765a0dbb26aE3
USDC_USD_FEED=0x729cFd10FC10A908aE9F9b35245cB6Ee14D44D6B

# Reserve IDs (discover via: forge script script/DiscoverReserves.s.sol --rpc-url https://rpc.mainnet.arc.io)
USDC_RESERVE_ID=0
WETH_RESERVE_ID=3
BTC_RESERVE_ID=2

# Risk parameters (basis points and seconds)
USDC_FACTOR_BPS=7500
USDC_FEED_MAX_AGE=86400
WETH_FACTOR_BPS=7000
WETH_FEED_MAX_AGE=86400
BTC_FACTOR_BPS=7000
BTC_FEED_MAX_AGE=86400

# Block explorer
ETHERSCAN_API_KEY=
